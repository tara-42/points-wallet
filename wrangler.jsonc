// Secrets to be set via 'wrangler secret put BETTER_AUTH_SECRET'
{
  "name": "takehome-assignment-ts",
  "main": "workers/app.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "build/client",
    "binding": "ASSETS"
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "takehome-assignment-ts-db",
      "database_id": "c507b01a-1170-4524-b2f9-1aa9e9283e31",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "takehome-assignment-ts-bucket"
    }
  ],
  "workflows": [
    {
      "binding": "EXAMPLE_WORKFLOW",
      "name": "takehome-assignment-ts-example-workflow",
      "class_name": "ExampleWorkflow"
    },
    {
      "binding": "SCRAPER_WORKFLOW",
      "name": "takehome-assignment-ts-scraper-workflow",
      "class_name": "ScraperWorkflow"
    },
    {
      "binding": "PIPELINE_WORKFLOW",
      "name": "takehome-assignment-ts-pipeline-workflow",
      "class_name": "PipelineWorkflow"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
